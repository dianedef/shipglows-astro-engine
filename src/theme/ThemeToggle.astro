---
/**
 * Bouton clair/sombre prêt à l'emploi : HTML accessible, icônes qui s'échangent sans flash,
 * style minimal entièrement réglable par variables CSS (voir README).
 *
 * Slots : `icon-off` (affichée quand l'axe ne vaut pas `pressedValue`, lune par défaut)
 * et `icon-on` (affichée quand il la vaut, soleil par défaut) : l'icône montre le mode où l'on va.
 */
import type { ThemeConfig } from "./index";

interface Props {
  config: ThemeConfig;
  /** Axe piloté ; par défaut `theme`, sinon le premier axe. */
  axis?: string;
  /** Valeur qui correspond à `aria-pressed="true"` ; par défaut `dark`. */
  pressedValue?: string;
  /** Nom accessible du bouton, ex. « Mode sombre ». */
  label: string;
  title?: string;
  class?: string;
}

const { config, label, title, class: className } = Astro.props;
const axisName = Astro.props.axis ?? ("theme" in config.axes ? "theme" : Object.keys(config.axes)[0]);
const axis = config.axes[axisName];
const pressedValue = Astro.props.pressedValue ?? (axis.values.includes("dark") ? "dark" : axis.values[1]);
---

<button
  type="button"
  class:list={["sg-theme-toggle", className]}
  data-sg-theme-toggle
  data-theme-config={JSON.stringify(config)}
  data-theme-axis={axisName}
  data-theme-pressed={pressedValue}
  aria-pressed="false"
  aria-label={label}
  title={title ?? label}
>
  <span class="sg-theme-toggle__icon sg-theme-toggle__icon--off" aria-hidden="true">
    <slot name="icon-off">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    </slot>
  </span>
  <span class="sg-theme-toggle__icon sg-theme-toggle__icon--on" aria-hidden="true">
    <slot name="icon-on">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </slot>
  </span>
</button>
<script is:inline define:vars={{ axis, pressedValue }}>
  // Synchronise aria-pressed dès le parsing, avant le premier rendu : pas d'icône erronée au chargement.
  (() => {
    const button = document.currentScript?.previousElementSibling;
    if (!button) return;
    const root = document.documentElement;
    let value = axis.attribute ? root.dataset[axis.attribute] : undefined;
    if (value === undefined && axis.classes) {
      value = Object.keys(axis.classes).find((key) => root.classList.contains(axis.classes[key]))
        ?? axis.values.find((key) => !(key in axis.classes));
    }
    button.setAttribute("aria-pressed", String((value ?? axis.default) === pressedValue));
  })();
</script>

<script>
  import { bindThemeControl } from "./client";

  document.querySelectorAll<HTMLElement>("[data-sg-theme-toggle]").forEach((button) => {
    bindThemeControl(JSON.parse(button.dataset.themeConfig ?? "{}"), button);
  });
</script>

<style is:global>
  /* :where() garde une spécificité nulle : n'importe quel sélecteur du site l'emporte. */
  :where(.sg-theme-toggle) {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    box-sizing: border-box;
    inline-size: var(--sg-theme-toggle-size, 2.75rem);
    block-size: var(--sg-theme-toggle-size, 2.75rem);
    padding: 0;
    border: var(--sg-theme-toggle-border, 1px solid color-mix(in srgb, currentColor 24%, transparent));
    border-radius: var(--sg-theme-toggle-radius, 999px);
    background: var(--sg-theme-toggle-bg, transparent);
    color: var(--sg-theme-toggle-color, currentColor);
    box-shadow: var(--sg-theme-toggle-shadow, none);
    font: inherit;
    cursor: pointer;
  }

  :where(.sg-theme-toggle:hover) {
    background: var(--sg-theme-toggle-hover-bg, var(--sg-theme-toggle-bg, transparent));
    color: var(--sg-theme-toggle-hover-color, var(--sg-theme-toggle-color, currentColor));
    border-color: var(--sg-theme-toggle-hover-border-color, currentColor);
    transform: translateY(var(--sg-theme-toggle-hover-lift, 0));
  }

  :where(.sg-theme-toggle:focus-visible) {
    outline: var(--sg-theme-toggle-focus-ring, 2px solid currentColor);
    outline-offset: var(--sg-theme-toggle-focus-offset, 2px);
  }

  :where(.sg-theme-toggle__icon) {
    display: grid;
    place-items: center;
    inline-size: var(--sg-theme-toggle-icon-size, 1.25rem);
    block-size: var(--sg-theme-toggle-icon-size, 1.25rem);
  }

  :where(.sg-theme-toggle__icon) > :where(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .sg-theme-toggle[aria-pressed="true"] .sg-theme-toggle__icon--off,
  .sg-theme-toggle[aria-pressed="false"] .sg-theme-toggle__icon--on {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :where(.sg-theme-toggle) {
      transition:
        transform var(--sg-theme-toggle-duration, 160ms) ease,
        background-color var(--sg-theme-toggle-duration, 160ms) ease,
        border-color var(--sg-theme-toggle-duration, 160ms) ease,
        color var(--sg-theme-toggle-duration, 160ms) ease;
    }
  }
</style>
